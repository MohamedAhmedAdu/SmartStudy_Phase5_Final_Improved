<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.smartstudy.controller.CourseTaskController" spacing="12" styleClass="content">
    <VBox spacing="3">
        <Label text="Courses &amp; Tasks" styleClass="page-title"/>
        <Label text="Manage academic data manually or review tasks created from a syllabus." styleClass="page-subtitle"/>
    </VBox>
    <HBox spacing="8">
        <Button text="Add Course" onAction="#addCourse" styleClass="primary-button"/>
        <Button text="Edit Course" onAction="#editCourse"/>
        <Button text="Delete Course" onAction="#deleteCourse" styleClass="danger-button"/>
    </HBox>
    <TableView fx:id="courseTable" prefHeight="235">
        <columns>
            <TableColumn fx:id="codeCol" text="Code" prefWidth="110"/>
            <TableColumn fx:id="nameCol" text="Course Name" prefWidth="260"/>
            <TableColumn fx:id="instructorCol" text="Instructor" prefWidth="220"/>
            <TableColumn fx:id="semesterCol" text="Semester" prefWidth="180"/>
        </columns>
    </TableView>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Add Task" onAction="#addTask" styleClass="primary-button"/>
        <Button text="Edit Task" onAction="#editTask"/>
        <Button text="Mark In Progress" onAction="#markInProgress" styleClass="warning-button"/>
        <Button text="Mark Completed" onAction="#markCompleted" styleClass="success-button"/>
        <Button text="Delete Task" onAction="#deleteTask" styleClass="danger-button"/>
    </HBox>
    <TableView fx:id="taskTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="taskTitleCol" text="Task" prefWidth="250"/>
            <TableColumn fx:id="typeCol" text="Type" prefWidth="110"/>
            <TableColumn fx:id="dueCol" text="Due Date" prefWidth="130"/>
            <TableColumn fx:id="weightCol" text="Weight" prefWidth="90"/>
            <TableColumn fx:id="hoursCol" text="Effort" prefWidth="90"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="125"/>
        </columns>
    </TableView>
    <Label fx:id="statusLabel" styleClass="status-text" wrapText="true"/>
</VBox>
