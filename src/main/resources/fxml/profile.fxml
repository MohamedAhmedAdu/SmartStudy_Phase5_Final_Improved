<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.smartstudy.controller.ProfileController" spacing="14" styleClass="content">
    <VBox spacing="3">
        <Label text="Profile &amp; Settings" styleClass="page-title"/>
        <Label text="Changes to available hours immediately regenerate your weekly plan." styleClass="page-subtitle"/>
    </VBox>
    <GridPane hgap="14" vgap="12" styleClass="panel" maxWidth="700">
        <Label text="Full name" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="380"/>
        <Label text="Email" GridPane.rowIndex="1"/>
        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="New password" GridPane.rowIndex="2"/>
        <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Leave blank to keep current password"/>
        <Label text="Available hours/week" GridPane.rowIndex="3"/>
        <TextField fx:id="hoursField" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="Example: 10"/>
    </GridPane>
    <Label text="Notification Preferences" styleClass="section-title"/>
    <VBox spacing="10" styleClass="panel" maxWidth="700">
        <CheckBox fx:id="emailNotifications" text="Email notifications (prototype preference; external delivery is not configured)"/>
        <CheckBox fx:id="inAppNotifications" text="In-app reminders"/>
        <CheckBox fx:id="weeklySummary" text="Weekly summary preference"/>
    </VBox>
    <Button text="Save Changes" onAction="#save" styleClass="primary-button" maxWidth="190"/>
    <Label fx:id="status" styleClass="status-text" wrapText="true"/>
</VBox>
