<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.smartstudy.controller.RegisterController" styleClass="auth-root">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="brand-bar">
            <VBox spacing="1"><Label text="SmartStudy" styleClass="brand-title"/><Label text="Student Registration" styleClass="brand-subtitle"/></VBox>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="11" maxWidth="500" styleClass="card">
            <Label text="Create Account" styleClass="page-title"/>
            <Label text="Password: at least 8 characters, one uppercase letter and one number." styleClass="hint-text" wrapText="true" maxWidth="380"/>
            <TextField fx:id="nameField" promptText="Full name" maxWidth="380"/>
            <TextField fx:id="emailField" promptText="University email" maxWidth="380"/>
            <PasswordField fx:id="passwordField" promptText="Password" maxWidth="380"/>
            <PasswordField fx:id="confirmField" promptText="Confirm password" maxWidth="380"/>
            <TextField fx:id="hoursField" promptText="Available study hours per week" maxWidth="380"/>
            <Button text="Register" onAction="#create" styleClass="primary-button" maxWidth="380" defaultButton="true"/>
            <Button text="Back to Login" onAction="#back" maxWidth="380"/>
            <Label fx:id="statusLabel" styleClass="error-text" wrapText="true" maxWidth="380"/>
        </VBox>
    </center>
</BorderPane>
